# Goalpost credentials — set ONLY what your config references (never commit).
# Native providers (used when a SUT/canonicaliser/extractor names them):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any OpenAI-compatible router/endpoint, referenced via api_key_env in config:
OPENROUTER_API_KEY=
# Local endpoints (Ollama, vLLM, LM Studio) need no key at all.
# Opt-in live smoke tests (never default):
GOALPOST_LIVE_TESTS=0
